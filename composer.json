{
    "name": "giovani/documentation-platform-engine",
    "description": "Git driven documentation engine for Laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Giovani\\DocumentationPlatformEngine\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "league/commonmark": "^2.5",
        "spatie/shiki-php": "^2.3"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Giovani\\DocumentationPlatformEngine\\DocumentationServiceProvider",
                "Giovani\\DocumentationPlatformEngine\\Providers\\DocumentationServiceProvider"
            ]
        }
    }
}