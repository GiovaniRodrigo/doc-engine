{
  "name": "giovani/documentation-engine",
  "description": "Markdown documentation engine with git versioning and AI integration",
  "autoload": {
    "psr-4": {
      "Giovani\\DocumentationEngine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Giovani\\DocumentationEngine\\Tests\\": "tests/"
    }
  },
  "bin": [
    "scripts/documentation-engine-env"
  ],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "league/commonmark": "^2.7"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.29"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Giovani\\DocumentationEngine\\DocumentationServiceProvider"
      ]
    }
  },
  "scripts": {
    "doc-engine:env": [
      "@php scripts/documentation-engine-env"
    ],
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint"
  }
}
