{
  "name": "giovani/documentation-engine",
  "description": "Markdown documentation engine with git versioning and AI integration",
  "autoload": {
    "psr-4": {
      "Giovani\\DocumentationEngine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Giovani\\DocumentationEngine\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Giovani\\DocumentationEngine\\DocumentationServiceProvider"
      ]
    }
  }
}
